{
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "model_data.js", "use": "@vercel/static" },
    { "src": "model_data.json", "use": "@vercel/static" },
    { "src": "ml_engine.js", "use": "@vercel/static" },
    { "src": "*.csv", "use": "@vercel/static" },
    { "src": "*.png", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
